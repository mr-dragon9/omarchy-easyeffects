#!/bin/bash

# Match Easy Effects to the current Omarchy theme.
#
# Writes a KDE color scheme named "Omarchy" from the theme's colors.toml,
# selects it for Easy Effects, and colors its spectrum/graphs from the same
# palette. Easy Effects reads colors only at startup, so a running instance is
# restarted, but only when something actually changed, keeping its window
# open or hidden as it was. Safe to run repeatedly and concurrently (one bar
# per monitor runs it): writes are skipped when nothing differs, and runs are
# serialized with flock.
#
# The bar widget takes the same lock (shared) around every easyeffects CLI
# call. Holding it exclusively until the restarted instance is up matters: a
# CLI call made while Easy Effects is down does not fail, it becomes the new
# main instance itself and never exits.

set -u

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_DIR/colors.toml"
SCHEME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes"
SCHEME="$SCHEME_DIR/Omarchy.colors"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
EE_RC="$CONFIG_HOME/easyeffectsrc"
EE_GRAPH="$CONFIG_HOME/easyeffects/db/graphrc"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-easyeffects-theme.lock"

for cmd in easyeffects omarchy-theme-color kreadconfig6 kwriteconfig6 flock; do
  command -v "$cmd" >/dev/null || exit 0
done
[[ -f $COLORS ]] || exit 0

exec 9>"$LOCK"
flock 9

declare -A THEME
while IFS=$'\t' read -r key value; do
  THEME[$key]="$value"
done < <(omarchy-theme-color --file "$COLORS" --all)

# Hex color for a theme key, trying fallbacks in order.
hex() {
  local key
  for key in "$@"; do
    if [[ ${THEME[$key]:-} =~ ^#[0-9A-Fa-f]{6}$ ]]; then
      printf "%s" "${THEME[$key]}"
      return
    fi
  done
  printf "#808080"
}

# KDE wants decimal "r,g,b".
rgb() {
  local h
  h=$(hex "$@")
  h="${h#\#}"
  printf "%d,%d,%d" "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

# mix <keyA> <keyB> <percent of B> -> "r,g,b"
mix() {
  local a b i
  local -a out=()
  a=$(hex "$1")
  b=$(hex "$2")
  a="${a#\#}"
  b="${b#\#}"
  for i in 0 2 4; do
    out+=($(((16#${a:i:2} * (100 - $3) + 16#${b:i:2} * $3 + 50) / 100)))
  done
  local IFS=,
  printf "%s" "${out[*]}"
}

background=$(rgb background)
dark_bg=$(rgb dark_background background)
darker_bg=$(rgb darker_background dark_background background)
lighter_bg=$(rgb lighter_background selection background)
foreground=$(rgb foreground)
light_fg=$(rgb light_foreground foreground)
accent=$(rgb accent blue)
muted=$(rgb muted color8)
red=$(rgb red)
orange=$(rgb orange yellow)
green=$(rgb green)
cyan=$(rgb cyan accent)
magenta=$(rgb magenta)
fg_inactive=$(mix foreground background 40)
hover=$(mix accent foreground 30)

color_set() {
  cat <<EOF
[$1]
BackgroundNormal=$2
BackgroundAlternate=$3
ForegroundNormal=$4
ForegroundInactive=$fg_inactive
ForegroundActive=$accent
ForegroundLink=$cyan
ForegroundVisited=$magenta
ForegroundNegative=$red
ForegroundNeutral=$orange
ForegroundPositive=$green
DecorationFocus=$accent
DecorationHover=$hover

EOF
}

scheme=$(
  cat <<EOF
# Generated by the io.github.mr-dragon9.easyeffects Omarchy plugin from the
# current Omarchy theme. Edits are overwritten on the next theme change.

[ColorEffects:Disabled]
Color=$background
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=$muted
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

EOF
  color_set "Colors:Window" "$background" "$dark_bg" "$foreground"
  color_set "Colors:View" "$dark_bg" "$(mix dark_background background 50)" "$foreground"
  color_set "Colors:Button" "$lighter_bg" "$(mix lighter_background background 50)" "$foreground"
  color_set "Colors:Tooltip" "$darker_bg" "$dark_bg" "$foreground"
  color_set "Colors:Header" "$darker_bg" "$dark_bg" "$foreground"
  color_set "Colors:Header][Inactive" "$darker_bg" "$dark_bg" "$foreground"
  color_set "Colors:Complementary" "$darker_bg" "$dark_bg" "$light_fg"
  cat <<EOF
[Colors:Selection]
BackgroundNormal=$accent
BackgroundAlternate=$(mix accent background 30)
ForegroundNormal=$background
ForegroundInactive=$(mix background accent 30)
ForegroundActive=$background
ForegroundLink=$background
ForegroundVisited=$background
ForegroundNegative=$red
ForegroundNeutral=$orange
ForegroundPositive=$green
DecorationFocus=$accent
DecorationHover=$hover

[General]
ColorScheme=Omarchy
Name=Omarchy
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=$darker_bg
activeBlend=$accent
activeForeground=$foreground
inactiveBackground=$dark_bg
inactiveBlend=$muted
inactiveForeground=$muted
EOF
)

[[ ${THEME[mode]:-dark} == light ]] && graph_scheme=light || graph_scheme=dark
declare -A GRAPH=(
  [colorScheme]=$graph_scheme
  [colorTheme]=userDefined
  [plotAreaBackgroundColor]=$dark_bg
  [backgroundColor]=$background
  [seriesColors]=$accent
  [borderColors]=$accent
  [labelTextColor]=$foreground
  [labelBackgroundColor]=$background
)

# Decide before touching anything, so an unchanged theme never restarts audio.
changed=false
if [[ -L $SCHEME || ! -f $SCHEME ]] || [[ $(<"$SCHEME") != "$scheme" ]]; then
  changed=true
fi
[[ $(kreadconfig6 --file "$EE_RC" --group UiSettings --key ColorScheme) == Omarchy ]] || changed=true
for key in "${!GRAPH[@]}"; do
  [[ $(kreadconfig6 --file "$EE_GRAPH" --group Graph --key "$key") == "${GRAPH[$key]}" ]] || changed=true
done
$changed || exit 0

# Stop Easy Effects first so it cannot write stale settings back on exit.
was_running=false
window_open=false
if pgrep -x easyeffects >/dev/null; then
  was_running=true
  hyprctl clients -j 2>/dev/null | grep -q '"class": "com.github.wwmm.easyeffects"' && window_open=true
  easyeffects -q 9>&-
  for _ in {1..50}; do
    pgrep -x easyeffects >/dev/null || break
    sleep 0.1
  done
fi

mkdir -p "$SCHEME_DIR" "$(dirname "$EE_GRAPH")"
rm -f "$SCHEME"
printf "%s\n" "$scheme" >"$SCHEME"
kwriteconfig6 --file "$EE_RC" --group UiSettings --key ColorScheme Omarchy
for key in "${!GRAPH[@]}"; do
  kwriteconfig6 --file "$EE_GRAPH" --group Graph --key "$key" "${GRAPH[$key]}"
done

# Relaunch in service mode (a running instance with no window already is one)
# rather than replaying the old command line, which may hold one-shot options.
if $was_running; then
  relaunch=(easyeffects --service-mode)
  $window_open || relaunch+=(--hide-window)

  # 9>&-: the new instance must not inherit the lock, or it holds it for its
  # whole lifetime and every widget call waits on it.
  if command -v uwsm-app >/dev/null; then
    setsid -f uwsm-app -- "${relaunch[@]}" >/dev/null 2>&1 9>&-
  else
    setsid -f "${relaunch[@]}" >/dev/null 2>&1 9>&-
  fi

  # Keep the lock until the new instance owns its sink, so no widget CLI call
  # can slip in first and become the main instance.
  for _ in {1..100}; do
    pactl list short sinks 2>/dev/null | grep -q easyeffects_sink && break
    sleep 0.1
  done
fi
